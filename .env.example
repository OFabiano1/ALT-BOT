# copia isso pra `.env` e preenche. `.env` nunca vai pro git nem pro deploy.

# ─── quem sou eu ───

# token do bot (developer portal -> bot -> reset token). sem isso nada liga.
TOKEN=
# id do servidor: com isso o slash sincroniza em segundos, sem demora ate 1h.
GUILD_ID=

# ─── tickets ───

# cargo que atende ticket + canal onde mora o painel (dropdown).
MOD_ROLE_ID=
TICKET_CHANNEL_ID=
# banner do painel. link do cdn do discord expira, troca por env, nunca hardcoda.
TICKET_BANNER_URL=
# gif que o bot reposta quando alguem manda. vazio = repost desligado.
REPOST_GIF=

# ─── emojis do servidor ───

# os 3 customs, pega com \:nome: no chat. sem isso o bot fica sem emoji.
AXOLOTL_EMOJI=<:02:1028808570466213918>
AMETHYST_EMOJI=<:amethyst:1554127047666831360>
DIAMANTE_EMOJI=<:diamond:1554260297789866134>

# ─── mudae ───

# id do bot do mudae (pra so reagir a ele) + espera padrao em minutos.
MUDAE_BOT_ID=432610292342587392
MUDAE_DEFAULT_MINUTES=60

# ─── deadlock ───

# custom do deadlock, mesmo esquema dos outros 3.
DEADLOCK_EMOJI=<:DEADLOCK:1556293610939482167>
# base da deadlock-api + timeout em segundos. padrao ja certo.
DEADLOCK_API_BASE=https://api.deadlock-api.com
DEADLOCK_TIMEOUT_S=10
# ranks e herois: "nome=<:custom:id>,..." separado por virgula.
# vazio = texto puro. ex: INITIATE=<:dl_rank_initiate:123>
DEADLOCK_RANK_EMOJIS=
DEADLOCK_HERO_EMOJIS=

# ─── ajuda ───

# banner da capa da ajuda. link do cdn expira, troca por env quando cair.
AJUDA_BANNER_URL=

# ─── github (push -> chat) ───

# usuario monitorado: todo commit publico dele aparece no chat.
GITHUB_USER=OFabiano1
# token opcional: sobe pra 5000/h e enxerga repo privado.
GITHUB_TOKEN=
# chat que recebe os commits.
GITHUB_CHANNEL_ID=1261521924002152501
# segredo do webhook (repo -> settings -> webhooks, mesmo valor).
# sem isso o hook nao liga e vale so o poll de 5min.
GITHUB_WEBHOOK_SECRET=
# porta do http (webhook). padrao 80.
PORT=80

# ─── diarias ───

# jogo do dia + chat que recebe o digest 00:00 (apaga 23:59).
TERMO_URL=https://term.ooo/
DIGEST_CHANNEL_ID=1310398751575113758

# ─── halloween ───

# chat do countdown diario + call que recebe o status. padrao ja certo.
HALLOWEEN_TEXT_CHANNEL_ID=1058335767274995752
HALLOWEEN_VOICE_CHANNEL_ID=1310398751575113758
